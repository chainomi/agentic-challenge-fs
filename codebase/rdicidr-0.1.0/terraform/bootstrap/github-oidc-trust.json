{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::488144151286:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:chainomi/agentic-challenge-fs:ref:refs/heads/devel",
            "repo:chainomi/agentic-challenge-fs:ref:refs/heads/stage",
            "repo:chainomi/agentic-challenge-fs:pull_request"
          ]
        }
      }
    }
  ]
}
